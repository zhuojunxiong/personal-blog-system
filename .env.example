# ============================================
# 稷下博客系统 — 环境变量配置
# ============================================
# 使用方法：
#   1. 复制此文件为 .env（注意：前面有个点）
#   2. 填写你的 DeepSeek API Key
#   3. 保存后 run.py 会自动读取
#
# ⚠️ 安全警告：
#   .env 文件已在 .gitignore 中排除，
#   切勿将包含真实 Key 的 .env 文件提交到 Git！
# ============================================

# ---------- DeepSeek AI 配置 ----------
# 【必填】你的 DeepSeek API Key（去 https://platform.deepseek.com 申请）
AI_API_KEY=sk-在此填入你的APIKey

# 【选填】模型选择（默认 deepseek-chat 即 DeepSeek-V3 最强旗舰）
# deepseek-chat      = DeepSeek-V3，综合最强，推荐日常使用
# deepseek-reasoner  = DeepSeek-R1，强推理，适合复杂逻辑分析
AI_MODEL=deepseek-chat

# 【选填】API 地址（默认官网，国内网络不稳定可换中转地址）
AI_BASE_URL=https://api.deepseek.com

# 【选填】最大输出 Token 数（默认 2000）
AI_MAX_TOKENS=2000

# 【选填】请求超时秒数（默认 30）
AI_TIMEOUT=30

# 【选填】设为 0 可临时关闭所有 AI 功能
AI_ENABLED=1

# ---------- Flask 安全密钥（不填则自动生成）----------
# SECRET_KEY=手动设置一个随机字符串
# WTF_CSRF_SECRET_KEY=手动设置一个随机字符串
